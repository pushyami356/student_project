{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:GetBucketLocation",
        "s3:ListBucketMultipartUploads"
      ],
      "Resource": [
        "arn:aws:s3:::student-cluster-loki-chunks-836003244254-eu-north-1",
        "arn:aws:s3:::student-cluster-loki-ruler-836003244254-eu-north-1"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:AbortMultipartUpload",
        "s3:ListMultipartUploadParts"
      ],
      "Resource": [
        "arn:aws:s3:::student-cluster-loki-chunks-836003244254-eu-north-1/*",
        "arn:aws:s3:::student-cluster-loki-ruler-836003244254-eu-north-1/*"
